{
  "name": "agent-sessions",
  "version": "0.0.0",
  "private": true,
  "description": "Export and import Claude Code and Codex sessions between computers.",
  "packageManager": "pnpm@10.13.1",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "smoke": "pnpm build && node --disable-warning=ExperimentalWarning e2e/smoke.mts && AGENT_SESSIONS_E2E=1 vitest run",
    "test": "vitest run",
    "verify:real": "AGENT_SESSIONS_REAL=1 vitest run"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-vite": "^6.0.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "5.0.5"
  }
}
